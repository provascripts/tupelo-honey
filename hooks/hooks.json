{
  "description": "tupelo-honey zero-token gates: mode directive at session start, debt markers and comment sync after every edit, module metrics at Stop. Silent unless a rule is broken.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/craft-mode.sh\" session", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/craft-debt-scan.sh\" --hook", "timeout": 30 },
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/craft-comment-sync.py\" --hook", "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/craft-metrics.py\" --gate", "timeout": 60 }
        ]
      }
    ]
  }
}
